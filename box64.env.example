# PaintTool SAI Ver.2 — Winlator 容器环境变量
# 用法：Winlator → Container Settings → Environment Variables → 逐行添加（"名称=值"）
# 关于顺序：先只加标 ★ 的 4 条，能跑之后再按需增加。

# ★ 严格标志位：SAI 用 SSE 做像素运算，标志位放宽会出现"颜色错位/笔迹偏移"
BOX64_DYNAREC_SAFEFLAGS=2

# ★ 强内存序：避免偶发崩溃、黑屏、保存时数据错
BOX64_DYNAREC_STRONGMEM=1

# ★ 关闭大 basic block：SAI 代码段 3.4 MB、跳转密集，大块优化容易踩坑
BOX64_DYNAREC_BIGBLOCK=0

# ★ 关闭 box64 自身的 AVX 暴露（SAI 不要求 AVX，避免走翻译分支）
BOX64_AVX=0

# 以下为"更保险"的附加项（卡顿/崩溃时再加）
BOX64_DYNAREC_FASTNAN=0
BOX64_DYNAREC_FASTROUND=0
BOX64_DYNAREC_X87DOUBLE=0
BOX64_DYNAREC_CALLRET=0

# 老程序兼容用的 GL 扩展年限（SAI 实际不用 GL，纯保守项）
MESA_EXTENSION_MAX_YEAR=2003

# ---------------------------------------------------------------------------
# 性能回滚实验（一次只改一条，改完重启容器）：
#   BOX64_DYNAREC_BIGBLOCK=1 → 2 → 3   逐步换性能，崩了就退回 0
#   BOX64_DYNAREC_STRONGMEM=0           掉帧严重时试，最可能导致"存盘损坏"
#   WINEDEBUG=-all                      减少日志开销
# ---------------------------------------------------------------------------
